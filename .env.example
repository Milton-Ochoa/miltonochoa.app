# Plantilla de configuración para AAMO. Copia a .env (producción) o .env.dev-api (dev local).
# .env.dev-api tiene prioridad sobre .env si existe (ver core/settings.py).

# Clave secreta de Django (obligatoria). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto

# True en desarrollo local, False en producción.
DEBUG=True

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (dj-database-url). Para SQLite local:
#   DATABASE_URL=sqlite:///db.sqlite3
# Para Postgres (producción):
#   DATABASE_URL=postgres://usuario:password@host:5432/nombre_db
DATABASE_URL=sqlite:///db.sqlite3

# Backend de caché: locmem (dev) | redis (prod). Si redis, define REDIS_URL.
CACHE_BACKEND=locmem
# REDIS_URL=redis://127.0.0.1:6379/1

# Clave para cifrado de contraseñas de gestores (usuarios). Opcional en dev.
# PASSWORD_ENCRYPT_KEY=

# Directorio de backups (opcional; default ../backups).
# BACKUP_DIR=
