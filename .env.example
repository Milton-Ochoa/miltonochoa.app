# Plantilla de configuración para AAMO. Copia a .env (producción) o .env.dev-api (dev local).
# .env.dev-api tiene prioridad sobre .env si existe (ver core/settings.py).

# Clave secreta de Django (obligatoria). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto

# True en desarrollo local, False en producción.
DEBUG=True

# Hosts permitidos extra, separados por coma. El apex (BASE_DOMAIN) y todos sus
# subdominios (.BASE_DOMAIN) se añaden automáticamente en settings. Aquí van extras:
# IP directa, o el dominio de Railway (*.up.railway.app) para el healthcheck.
ALLOWED_HOSTS=localhost,127.0.0.1

# Dominio base del enrutado por subdominios (cada área = un subdominio).
#   prod: BASE_DOMAIN=miltonochoa.app   → programacion.miltonochoa.app, etc.
#   dev:  BASE_DOMAIN=lvh.me            → programacion.lvh.me:8000 (resuelve a 127.0.0.1)
BASE_DOMAIN=miltonochoa.app

# Detrás del proxy TLS de Railway: activa la redirección a HTTPS (settings ya define
# SECURE_PROXY_SSL_HEADER para no entrar en bucle).
SECURE_SSL_REDIRECT=True

# Base de datos (dj-database-url). Para SQLite local:
#   DATABASE_URL=sqlite:///db.sqlite3
# Para Postgres (Supabase, producción) — usa el "Session pooler" (puerto 5432):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Backend de caché: locmem (default) | redis.
# IMPORTANTE: locmem es POR PROCESO. El deploy usa gunicorn con UN worker + hilos
# (-k gthread) precisamente para que locmem sea coherente (rate-limit y throttle de
# auditoría dependen de ello). Si algún día subes a varios workers/procesos, cambia
# CACHE_BACKEND=redis y define REDIS_URL, o esas protecciones dejan de ser fiables.
CACHE_BACKEND=locmem
# REDIS_URL=redis://127.0.0.1:6379/1

# Directorio de backups (opcional; default ../backups).
# BACKUP_DIR=
