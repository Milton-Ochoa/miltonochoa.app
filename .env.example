# Plantilla de configuración para AAMO. Copia a .env (producción) o .env.dev-api (dev local).
# .env.dev-api tiene prioridad sobre .env si existe (ver core/settings.py).

# Clave secreta de Django (obligatoria). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto

# True en desarrollo local, False en producción.
DEBUG=True

# Hosts permitidos extra, separados por coma. El apex (BASE_DOMAIN) y todos sus
# subdominios (.BASE_DOMAIN) se añaden automáticamente en settings. Aquí van extras:
# IP directa, o el dominio de Railway (*.up.railway.app) para el healthcheck.
ALLOWED_HOSTS=localhost,127.0.0.1

# Dominio base del enrutado por subdominios (cada área = un subdominio).
#   prod: BASE_DOMAIN=miltonochoa.app   → programacion.miltonochoa.app, etc.
#   dev:  BASE_DOMAIN=lvh.me            → programacion.lvh.me:8000 (resuelve a 127.0.0.1)
BASE_DOMAIN=miltonochoa.app

# Detrás del proxy TLS de Railway: activa la redirección a HTTPS (settings ya define
# SECURE_PROXY_SSL_HEADER para no entrar en bucle).
SECURE_SSL_REDIRECT=True

# Base de datos (dj-database-url). Para SQLite local:
#   DATABASE_URL=sqlite:///db.sqlite3
# Para Postgres (Supabase, producción) — usa el "Session pooler" (puerto 5432):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Backend de caché: locmem (default) | redis.
# IMPORTANTE: locmem es POR PROCESO. El deploy usa gunicorn con UN worker + hilos
# (-k gthread) precisamente para que locmem sea coherente (rate-limit y throttle de
# auditoría dependen de ello). Si algún día subes a varios workers/procesos, cambia
# CACHE_BACKEND=redis y define REDIS_URL, o esas protecciones dejan de ser fiables.
CACHE_BACKEND=locmem
# REDIS_URL=redis://127.0.0.1:6379/1

# Directorio de backups (opcional; default ../backups).
# BACKUP_DIR=

# ── Almacenamiento de archivos (soportes de pago de viáticos) ────────────────
# En dev deja USE_SUPABASE_STORAGE sin definir (o False) → los archivos caen en
# ./media/ (disco local). En producción ponlo en True y define las 5 vars S3 del
# bucket privado de Supabase Storage. Si está en True, las 5 son OBLIGATORIAS
# (settings.py las lee sin default → un deploy sin ellas falla al arrancar).
USE_SUPABASE_STORAGE=False
# SUPABASE_BUCKET=soportes-pago
# SUPABASE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=<region>           # p. ej. us-east-1
# SUPABASE_S3_ACCESS_KEY=<access-key>
# SUPABASE_S3_SECRET_KEY=<secret-key>

# ── Correo (avisos de viáticos a financiera, vía Resend SMTP) ────────────────
# En dev con DEBUG=True el correo se IMPRIME en la consola (no se envía): no hace
# falta configurar nada. Para enviar de verdad (prod, o prueba real en dev) define
# EMAIL_HOST_PASSWORD con la API key de Resend (re_...) y, si quieres forzar SMTP
# en dev, descomenta EMAIL_BACKEND.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend                 # Resend exige el usuario literal "resend"
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxx    # API key de Resend (secreta; no commitear)
# DEFAULT_FROM_EMAIL=AAMO <notificaciones@miltonochoa.app>
# Destinatario de los avisos. Default = correo de pruebas; en prod ponlo en financiero:
# VIATICOS_NOTIFICAR_A=financiero@aamocolombia.com
# Destinatario del aviso de legalización enviada (default ya es el financiero):
# VIATICOS_LEGALIZACION_NOTIFICAR_A=financiero@aamocolombia.com
